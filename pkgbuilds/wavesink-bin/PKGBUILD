# Maintainer: CalmaSaCow <calmasacow@gmail.com>
pkgname=wavesink-bin
pkgver=1.1.0
pkgrel=1
pkgdesc="Linux-native PipeWire mixer with per-app routing, independent mixes, and per-input audio effects"
arch=('x86_64')
url="https://github.com/calmasacow/WaveSink"
license=('GPL-3.0-only')
depends=('glibc' 'libgcc' 'glib2' 'gtk3' 'gdk-pixbuf2' 'cairo' 'dbus'
         'webkit2gtk-4.1' 'libsoup3' 'libpipewire' 'pipewire-pulse'
         'wireplumber' 'hicolor-icon-theme' 'libayatana-appindicator')
provides=('wavesink' 'sink')
conflicts=('wavesink' 'sink' 'sink-bin')
replaces=('sink-bin')
options=('!strip' '!debug')
source=("https://github.com/calmasacow/WaveSink/releases/download/v${pkgver}/wavesink_${pkgver}_amd64.deb"
        "https://raw.githubusercontent.com/calmasacow/WaveSink/v${pkgver}/LICENSE")
noextract=("wavesink_${pkgver}_amd64.deb")
sha256sums=('ae3fadaae3235df44c0cfafd7948bb96079acac89d197a2bd1e967d71fd01f08'
            '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986')

package() {
  cd "$srcdir"
  bsdtar -xf "wavesink_${pkgver}_amd64.deb"
  bsdtar -xf data.tar.* -C "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
